{
    "name": "Find my Way",
    "description": "Find the most optimal routes to reach your destinations on Google Maps",
    "version": "1.0",
    "manifest_version": 3,

    "permissions": ["activeTab"],

    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },

        "default_popup": "popup/popup.html"
    },

    "content_scripts": [
        {
            "matches": ["https://www.google.com/maps/*"],
            "js": ["content.js"],
            "css": ["styles.css"]
        }
    ]
}